{
    "name": "ngne",
    "version": "0.1.0",
    "type": "module",
    "private": true,
    "files": [
        "dist/engine",
        "docs/guide.md",
        "docs/contracts"
    ],
    "scripts": {
        "dev": "vite --host 127.0.0.1",
        "build": "tsc --noEmit && tsc -p tests/tsconfig.browser.json && tsc -p benchmarks/browser/tsconfig.json && tsc -p tsconfig.lib.json && tsc -p tests/tsconfig.api.json && vite build",
        "build:browser": "vite build --mode browser --outDir dist-browser",
        "typecheck": "tsc --noEmit",
        "test": "tsx --test tests/*.test.ts tooling/tests/*.test.ts",
        "test:browser": "tsx tests/browser-ci.ts",
        "bench": "tsx benchmarks/cpu/benchmark.ts",
        "bench:all": "powershell -NoProfile -ExecutionPolicy Bypass -File benchmarks/run-all.ps1",
        "bench:compare": "node benchmarks/compare-runs.mjs",
        "format": "prettier --write src demo examples tests benchmarks tooling plans docs .agents .github .vscode \"./*.{ts,md,json,html}\"",
        "format:check": "prettier --check src demo examples tests benchmarks tooling plans docs .agents .github .vscode \"./*.{ts,md,json,html}\"",
        "preview": "vite preview --host 127.0.0.1",
        "bench:content": "node benchmarks/content/run.mjs",
        "test:installed": "node tests/installed-content.mjs",
        "typecheck:tooling": "tsc -p tooling/tsconfig.node.json",
        "check:migration": "tsx tooling/commands/check-migration.ts"
    },
    "exports": {
        ".": {
            "types": "./dist/engine/index.d.ts",
            "import": "./dist/engine/index.js"
        }
    },
    "devDependencies": {
        "@types/node": "24.13.6",
        "@webgpu/types": "0.1.72",
        "prettier": "3.9.6",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "vite": "^7.3.1"
    },
    "description": "A TypeScript 2D sprite engine with a playable retro showcase and zero runtime dependencies.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/that-webdev-dude/ngne.git"
    },
    "engines": {
        "node": ">=24"
    }
}
