{
    "compilerOptions": {
        "target": "ES2023",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2023"],
        "types": ["node"],
        "strict": true,
        "allowJs": true,
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": [
        "commands/**/*.ts",
        "core/**/*.ts",
        "evidence/**/*.ts",
        "tests/*.test.ts",
        "suites/**/*.ts"
    ],
    "exclude": [
        "suites/benchmarks/cpu/benchmark.ts",
        "suites/benchmarks/cpu/churn-schema.ts",
        "suites/benchmarks/rendering/**/*.ts"
    ]
}
